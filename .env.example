# Example environment variables for local development
# Copy this file to .env and adjust values if needed

# Use a long random secret (recommended 32+ characters)
JWT_SECRET=change_me

# Default seeded user (created via data.sql for development/testing)
DEFAULT_USER_EMAIL=user@test.com
DEFAULT_USER_PASSWORD=test123
# NOTE: password is stored in DB as bcrypt hash, but you login using the plain value above.